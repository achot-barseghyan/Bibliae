# Copier en .env (jamais commité) et remplir.
POSTGRES_PASSWORD=change-moi
# 32 caractères minimum, par ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Envoi des e-mails (codes de vérification). Vide = Mailpit local (http://localhost:8025).
# Brevo (SMTP & API > onglet SMTP) : identifiant + clé SMTP « xsmtpsib-… » (pas la clé API « xkeysib-… »).
# Le @ de l'identifiant s'écrit %40 :
# SMTP_URL=smtp://8a1b2c001%40smtp-brevo.com:xsmtpsib-XXXX@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM=Bibliae <no-reply@bibliae.app>
# Origines autorisées, séparées par des virgules (vide = app Capacitor + Vite local).
CORS_ORIGINS=
