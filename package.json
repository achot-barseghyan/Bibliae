{
  "name": "ionic-app-base",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-sql-wasm.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "android": "cap run android",
    "android:live": "npm run build && cross-env CAP_LIVE_RELOAD=true cap sync android && cross-env CAP_LIVE_RELOAD=true cap run android",
    "android:device:live": "npm run build && adb reverse tcp:5173 tcp:5173 && cross-env CAP_LIVE_RELOAD=true CAP_LIVE_RELOAD_HOST=localhost cap sync android && cross-env CAP_LIVE_RELOAD=true CAP_LIVE_RELOAD_HOST=localhost cap run android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "framer-motion": "^13.2.0",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "^2.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cross-env": "^10.1.0",
    "cypress": "^13.5.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "sql.js": "1.11.0"
  }
}
